{
  // Depois de `npx wrangler d1 create docao-capitalista`, troque database_id
  // pelo UUID que o comando imprimir. O zero abaixo só segura o arquivo.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docao-capitalista-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    // Um jogador só: amostra 1 pra não perder o único rastro.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docao-capitalista",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://docao-capitalist.vercel.app"
  }
}
