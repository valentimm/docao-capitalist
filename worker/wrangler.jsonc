{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docao-capitalista-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docao-capitalista",
      "database_id": "c7bbc85b-7166-4639-af06-b33166fb3920",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://docao-capitalist.vercel.app,https://docapital.mvalentim.dev"
  }
}
